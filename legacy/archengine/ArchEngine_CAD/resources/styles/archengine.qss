/* ArchEngine CAD Stylesheet - Dark Theme */

/* Main Window */
QMainWindow {
    background-color: #1a1a2e;
    color: #e0e0e0;
}

/* Menu Bar */
QMenuBar {
    background-color: #16213e;
    color: #e0e0e0;
    padding: 2px;
}

QMenuBar::item {
    padding: 4px 8px;
    background: transparent;
}

QMenuBar::item:selected {
    background-color: #0f3460;
}

QMenu {
    background-color: #16213e;
    color: #e0e0e0;
    border: 1px solid #0f3460;
}

QMenu::item {
    padding: 6px 24px;
}

QMenu::item:selected {
    background-color: #0f3460;
}

QMenu::separator {
    height: 1px;
    background: #0f3460;
    margin: 4px 8px;
}

/* Toolbar */
QToolBar {
    background-color: #16213e;
    border: none;
    spacing: 4px;
    padding: 4px;
}

QToolBar::separator {
    width: 1px;
    background: #0f3460;
    margin: 4px 8px;
}

QToolButton {
    background-color: transparent;
    color: #e0e0e0;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 8px;
}

QToolButton:hover {
    background-color: #0f3460;
    border: 1px solid #1a5490;
}

QToolButton:pressed {
    background-color: #1a5490;
}

QToolButton:checked {
    background-color: #1a5490;
    border: 1px solid #4080ff;
}

/* Dock Widgets */
QDockWidget {
    color: #e0e0e0;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QDockWidget::title {
    background-color: #16213e;
    padding: 6px;
    text-align: left;
}

QDockWidget::close-button, QDockWidget::float-button {
    background: transparent;
    border: none;
    padding: 2px;
}

QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background-color: #0f3460;
}

/* Status Bar */
QStatusBar {
    background-color: #16213e;
    color: #a0a0a0;
}

QStatusBar::item {
    border: none;
}

/* Scrollbars */
QScrollBar:vertical {
    background-color: #1a1a2e;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #0f3460;
    min-height: 30px;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #1a5490;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #1a1a2e;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #0f3460;
    min-width: 30px;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #1a5490;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* Tree Widget (Project Browser) */
QTreeWidget, QTreeView {
    background-color: #1a1a2e;
    color: #e0e0e0;
    border: none;
    outline: none;
}

QTreeWidget::item, QTreeView::item {
    padding: 4px;
}

QTreeWidget::item:selected, QTreeView::item:selected {
    background-color: #0f3460;
}

QTreeWidget::item:hover, QTreeView::item:hover {
    background-color: #16213e;
}

/* General Widgets */
QWidget {
    background-color: #1a1a2e;
    color: #e0e0e0;
}

QLabel {
    color: #e0e0e0;
}

QPushButton {
    background-color: #0f3460;
    color: #e0e0e0;
    border: 1px solid #1a5490;
    border-radius: 4px;
    padding: 6px 12px;
}

QPushButton:hover {
    background-color: #1a5490;
}

QPushButton:pressed {
    background-color: #4080ff;
}

QLineEdit {
    background-color: #16213e;
    color: #e0e0e0;
    border: 1px solid #0f3460;
    border-radius: 4px;
    padding: 4px 8px;
}

QLineEdit:focus {
    border: 1px solid #4080ff;
}

QSpinBox, QDoubleSpinBox {
    background-color: #16213e;
    color: #e0e0e0;
    border: 1px solid #0f3460;
    border-radius: 4px;
    padding: 4px 8px;
}

QComboBox {
    background-color: #16213e;
    color: #e0e0e0;
    border: 1px solid #0f3460;
    border-radius: 4px;
    padding: 4px 8px;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #16213e;
    color: #e0e0e0;
    border: 1px solid #0f3460;
    selection-background-color: #0f3460;
}

/* Graphics View */
QGraphicsView {
    border: none;
}

/* Tooltips */
QToolTip {
    background-color: #16213e;
    color: #e0e0e0;
    border: 1px solid #0f3460;
    padding: 4px;
}
