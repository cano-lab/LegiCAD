#version 450

/**
 * Irradiance Convolution Compute Shader
 *
 * Convolves an HDR environment cubemap to create a diffuse irradiance map.
 * Uses cosine-weighted hemisphere integration for Lambertian diffuse.
 * Output is typically 32x32 or 64x64 per face (diffuse doesn't need high res).
 */

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Input environment cubemap
layout(set = 0, binding = 0) uniform samplerCube environmentMap;

// Output irradiance cubemap (6 layers for cube faces)
layout(set = 0, binding = 1, rgba16f) uniform writeonly imageCube irradianceMap;

layout(push_constant) uniform ConvolutionParams {
    uint faceSize;         // Size of output face (e.g., 32 or 64)
    uint sampleCount;      // Number of samples for integration
    float _padding1;
    float _padding2;
} params;

const float PI = 3.14159265359;

// Get direction for cubemap face and UV
vec3 getCubemapDirection(uint face, vec2 uv) {
    // Convert UV from [0,1] to [-1,1]
    vec2 st = uv * 2.0 - 1.0;

    vec3 dir;
    switch (face) {
        case 0: dir = vec3( 1.0, -st.y, -st.x); break;  // +X
        case 1: dir = vec3(-1.0, -st.y,  st.x); break;  // -X
        case 2: dir = vec3( st.x,  1.0,  st.y); break;  // +Y
        case 3: dir = vec3( st.x, -1.0, -st.y); break;  // -Y
        case 4: dir = vec3( st.x, -st.y,  1.0); break;  // +Z
        case 5: dir = vec3(-st.x, -st.y, -1.0); break;  // -Z
    }

    return normalize(dir);
}

// Van der Corput sequence for low-discrepancy sampling
float vanDerCorput(uint bits) {
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10;
}

vec2 hammersley(uint i, uint N) {
    return vec2(float(i) / float(N), vanDerCorput(i));
}

// Uniform hemisphere sampling (cosine-weighted would be: sqrt(1-u1), phi)
vec3 hemisphereSample(vec2 xi, vec3 N) {
    // Cosine-weighted hemisphere sampling
    float phi = 2.0 * PI * xi.x;
    float cosTheta = sqrt(1.0 - xi.y);
    float sinTheta = sqrt(xi.y);

    vec3 H;
    H.x = cos(phi) * sinTheta;
    H.y = sin(phi) * sinTheta;
    H.z = cosTheta;

    // Transform from tangent space to world space
    vec3 up = abs(N.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, N));
    vec3 bitangent = cross(N, tangent);

    return tangent * H.x + bitangent * H.y + N * H.z;
}

void main() {
    uvec3 globalID = gl_GlobalInvocationID;

    // Check bounds
    if (globalID.x >= params.faceSize || globalID.y >= params.faceSize) {
        return;
    }

    // Calculate UV for this texel
    vec2 uv = (vec2(globalID.xy) + 0.5) / float(params.faceSize);

    // Process all 6 faces
    for (uint face = 0; face < 6; face++) {
        // Get the direction for this texel
        vec3 N = getCubemapDirection(face, uv);

        // Integrate hemisphere
        vec3 irradiance = vec3(0.0);
        float totalWeight = 0.0;

        for (uint i = 0u; i < params.sampleCount; i++) {
            vec2 xi = hammersley(i, params.sampleCount);
            vec3 sampleDir = hemisphereSample(xi, N);

            float NdotL = max(dot(N, sampleDir), 0.0);

            if (NdotL > 0.0) {
                vec3 sampleColor = texture(environmentMap, sampleDir).rgb;
                irradiance += sampleColor * NdotL;
                totalWeight += NdotL;
            }
        }

        irradiance = (irradiance / totalWeight) * PI;

        // Write to irradiance cubemap
        imageStore(irradianceMap, ivec3(globalID.xy, face), vec4(irradiance, 1.0));
    }
}
